# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets / signing — never commit (this repo is open source).
# Android signing is also covered by android/.gitignore (key.properties, *.jks).
**/key.properties
**/*.jks
**/*.keystore
# Firebase config files contain project keys — each developer/CI supplies their own.
**/google-services.json
**/GoogleService-Info.plist
# Google Play service account keys — point fastlane at one with
# PLAY_STORE_JSON_KEY_PATH, or hand it to CI as PLAY_STORE_JSON_KEY_DATA.
**/*service_account*.json
**/*service-account*.json
**/play-store-*.json
.env
*.env

# Local-only documentation (design specs, setup notes) — kept out of the repo.
docs/

# Fastlane — generated docs, run reports and locally installed gems.
**/fastlane/README.md
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/test_output/
**/.bundle/
android/vendor/
ios/vendor/
